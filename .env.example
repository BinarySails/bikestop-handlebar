# Disables the route guards in `src/lib/auth/require-auth.ts`.
#
# When `true`, `requireAuth` and `requirePolicy` are no-ops and every action is
# visible, so you can work on the UI without seeding roles. The permission
# checks themselves stay in place — only the enforcement is bypassed, which also
# makes `useHasPolicy` return `true` everywhere.
#
# Never set this to `true` in a deployed environment.
VITE_DISABLE_AUTH=false

# Selects which backend the Orval API client is generated against
# (DEVELOPMENT -> http://localhost:8080, PRODUCTION -> https://ciclo.binarysails.com).
ENVIRONMENT=DEVELOPMENT
